# load the water distribution network domain
wdn := load example/wdn

# load the agent repository
agents := load example/agents

# load the industrial process knowledge graph
simple := load example/simple

seg := translate simple
trees := traverse t.head seg

# configure the control loops corresponding to state estimation trees
lc0 := configure controller agents [trees[0]] [u]
lc1 := configure controller agents [trees[1]] [u]
lc2 := configure controller agents [trees[2]] [u]
lc3 := configure controller agents [trees[3]] [u]
lc4 := configure controller agents [trees[4]] [u]
lc5 := configure controller agents [trees[5]] [u]
lc6 := configure controller agents [trees[6]] [u]


# validate liveness
lc0 := compose lc0
lc1 := compose lc1
lc2 := compose lc2
lc3 := compose lc3
lc4 := compose lc4
lc5 := compose lc5
lc6 := compose lc6

# mermaid representation
mermaid trees[0]
mermaid trees[1]
mermaid trees[2]
mermaid trees[3]
mermaid trees[4]
mermaid trees[5]
mermaid trees[6]


# a fault occurs on device 2
# reload process remove device 2

simple := load example/simple

seg := translate simple
newTrees := traverse t.head seg

# configure the control loops corresponding to state estimation trees
newlc0 := configure controller agents [newTrees[0]] [u] # newTrees[0] agents controller u
newlc1 := configure controller agents [newTrees[1]] [u] # newTrees[1] agents controller u

# mermaid representation
mermaid newTrees[0]
mermaid newTrees[1]
